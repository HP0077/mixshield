# Copy this file to .env and fill in the values. .env is git-ignored: never commit it.
# Without any key you can still run the tests, "Run 1" in the playground and the replay of recorded runs.

# Muse Spark Open (open weights), served by Baseten. Needed for the MixShield screen's classifier,
# playground runs 2 and 3, and the "Try to fool MixShield" tab. Get it: baseten.co > Settings > API keys.
BASETEN_API_KEY=

# Hugging Face read token. Needed to download Llama Prompt Guard 2 (a gated model: accept its licence first at
# https://huggingface.co/meta-llama/Llama-Prompt-Guard-2-86M). Get it: huggingface.co/settings/tokens.
HF_TOKEN=

# Muse Spark through the Meta Model API (https://api.meta.ai). Only the benchmark scripts in bench/ use it
# (agent runs and Hindi translation). The playground and the proxy do not need it.
MODEL_API_KEY=

# Optional: where Hugging Face keeps downloaded models (the default is under your user folder). Uncomment to move it.
# HF_HOME=
